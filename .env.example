# Discord application (only DISCORD_TOKEN is read by the bot; the others are kept for reference)
APPLICATION_ID=
PUBLIC_KEY=
DISCORD_TOKEN=

# Postgres connection string. For Supabase without IPv6, use the session pooler on port 5432.
DATABASE_URL=

# Optional: minutes between background scrapes (default 30)
# SCRAPE_INTERVAL_MINUTES=30

# Optional: path to pdflatex for resume tailoring (default: pdflatex on PATH)
# PDFLATEX=/usr/bin/pdflatex
# Resumes are compiled inside bubblewrap (apt install bubblewrap). Only turn
# this off if you are the bot's only user.
# RESUME_SANDBOX=off

# Optional: Brave Search API key to show likely recruiters in Apply threads
# BRAVE_API_KEY=

# Optional: Gemini API key. When set, resumes are tailored by Gemini (it returns
# the .tex, the bot compiles it with pdflatex) instead of the built-in scorer.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
